# Cloudflare static assets: response headers (the static export can't use next.config headers)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), fullscreen=(self), screen-wake-lock=(self), gamepad=(self)

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/audio/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/games/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
