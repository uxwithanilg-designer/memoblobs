# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# R2 upload bookkeeping (scripts/r2/upload.mjs)
.r2-uploaded.json

# local `wrangler dev` state
.wrangler/

# poster / thumbnail / title-logo pipeline: fonts are fetched by scripts/art/get_fonts.py, renders are scratch
/scripts/art/fonts/
/scripts/art/out/
/scripts/art/__pycache__/
